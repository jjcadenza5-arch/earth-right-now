{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "ern-now-moment-media",
  "main": "src/index.js",
  "compatibility_date": "2026-09-28",
  "vars": {
    "ERN_NOW_MOMENT_PHOTO_ENABLED": "false",
    "ERN_PUBLIC_ORIGIN": "https://earthrightnow.app",
    "ERN_CATALOG_URL": "https://earthrightnow.app/data/sources.json"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MEDIA_STATE",
        "class_name": "MediaState"
      }
    ]
  },
  "r2_buckets": [
    {
      "binding": "NOW_MOMENT_MEDIA",
      "bucket_name": "ern-now-moment-media"
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "exports": {
    "MediaState": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
