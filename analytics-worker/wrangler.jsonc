{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "ern-analytics-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-02",
  "vars": {
    "ERN_ANALYTICS_ENABLED": "true",
    "ERN_PUBLIC_ORIGIN": "https://earthrightnow.app",
    "ERN_ANALYTICS_RETENTION_DAYS": "90"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ANALYTICS_STATE",
        "class_name": "AnalyticsState"
      }
    ]
  },
  "exports": {
    "AnalyticsState": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
