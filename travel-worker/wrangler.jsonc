{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "ern-travel-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-26",
  "vars": {
    "ERN_VIATOR_API_ENABLED": "true",
    "ERN_VIATOR_PUBLIC_PRODUCTS_ENABLED": "false",
    "ERN_VIATOR_PRODUCT_VALIDATION_ENABLED": "false",
    "ERN_PUBLIC_ORIGIN": "https://earthrightnow.app",
    "ERN_VIATOR_MAPPING_URL": "https://earthrightnow.app/data/viator-destination-map.json",
    "VIATOR_API_BASE": "https://api.sandbox.viator.com/partner"
  }
}
