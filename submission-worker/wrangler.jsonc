{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "ern-submission-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-28",
  "vars": {
    "ERN_SUBMISSION_ENABLED": "false",
    "ERN_PUBLIC_ORIGIN": "https://earthrightnow.app",
    "ERN_SUBMISSION_RETENTION_DAYS": "30"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SUBMISSION_INBOX",
        "class_name": "SubmissionInbox"
      }
    ]
  },
  "exports": {
    "SubmissionInbox": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
