{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ERN Source v1",
  "type": "object",
  "required": [
    "id",
    "placeId",
    "title",
    "truth",
    "permission",
    "health",
    "playback",
    "sourceUrl"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "placeId": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "region": {
      "type": "string"
    },
    "lat": {
      "type": [
        "number",
        "null"
      ],
      "minimum": -90,
      "maximum": 90
    },
    "lon": {
      "type": [
        "number",
        "null"
      ],
      "minimum": -180,
      "maximum": 180
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "truth": {
      "enum": [
        "LIVE_VIDEO",
        "LIVE_IMAGE",
        "EXTERNAL_LIVE",
        "PARTNER",
        "PREVIEW"
      ]
    },
    "permission": {
      "enum": [
        "EMBED_ALLOWED",
        "LINK_ONLY",
        "PARTNER_PERMISSION",
        "UNKNOWN"
      ]
    },
    "health": {
      "enum": [
        "HEALTHY",
        "DEGRADED",
        "OFFLINE",
        "UNKNOWN"
      ]
    },
    "playback": {
      "enum": [
        "EMBED",
        "IMAGE_REFRESH",
        "EXTERNAL",
        "PREVIEW"
      ]
    },
    "sourceUrl": {
      "type": "string",
      "pattern": "^https?://"
    },
    "embedUrl": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^https?://"
    },
    "thumbnailUrl": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^https?://"
    },
    "attribution": {
      "type": [
        "string",
        "null"
      ]
    },
    "checkedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "lastSuccessfulCheck": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "failureReason": {
      "type": [
        "string",
        "null"
      ]
    },
    "quality": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "freshness": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "story": {
      "type": [
        "string",
        "null"
      ]
    },
    "timeZone": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "moment": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "rightsBasis": {
      "type": [
        "string",
        "null"
      ]
    },
    "officialUrl": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^https?://"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "coordinateBasis": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "CAMERA_EXACT",
        "PLACE_REFERENCE",
        "REGION_REFERENCE",
        null
      ]
    },
    "coordinateSourceUrl": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^https://"
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "playback": {
            "const": "EMBED"
          }
        },
        "required": [
          "playback"
        ]
      },
      "then": {
        "required": [
          "embedUrl"
        ],
        "properties": {
          "permission": {
            "enum": [
              "EMBED_ALLOWED",
              "PARTNER_PERMISSION"
            ]
          },
          "embedUrl": {
            "type": "string",
            "pattern": "^https://"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "permission": {
            "const": "LINK_ONLY"
          }
        },
        "required": [
          "permission"
        ]
      },
      "then": {
        "properties": {
          "playback": {
            "const": "EXTERNAL"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "truth": {
            "const": "EXTERNAL_LIVE"
          }
        },
        "required": [
          "truth"
        ]
      },
      "then": {
        "properties": {
          "playback": {
            "const": "EXTERNAL"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "playback": {
            "const": "IMAGE_REFRESH"
          }
        },
        "required": [
          "playback"
        ]
      },
      "then": {
        "properties": {
          "truth": {
            "const": "LIVE_IMAGE"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "truth": {
            "const": "PREVIEW"
          }
        },
        "required": [
          "truth"
        ]
      },
      "then": {
        "properties": {
          "playback": {
            "const": "PREVIEW"
          },
          "health": {
            "not": {
              "const": "HEALTHY"
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "coordinateBasis"
        ],
        "properties": {
          "coordinateBasis": {
            "type": "string"
          }
        }
      },
      "then": {
        "required": [
          "lat",
          "lon",
          "coordinateSourceUrl"
        ]
      }
    },
    {
      "if": {
        "required": [
          "coordinateSourceUrl"
        ],
        "properties": {
          "coordinateSourceUrl": {
            "type": "string"
          }
        }
      },
      "then": {
        "required": [
          "lat",
          "lon",
          "coordinateBasis"
        ]
      }
    }
  ]
}
